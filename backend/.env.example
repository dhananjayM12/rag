# Backend configuration
# Postgres (with pgvector) connection string
DATABASE_URL=postgresql+psycopg2://upsc:upsc@localhost:5432/upsc

# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Dimension of stored content embeddings (used only by the future RAG milestone)
EMBED_DIM=384
