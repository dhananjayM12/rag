# Backend configuration
# Postgres (with pgvector) connection string
DATABASE_URL=postgresql+psycopg2://upsc:upsc@localhost:5432/upsc

# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Dimension of stored content embeddings
EMBED_DIM=384

# --- RAG (all local / open by default) ---
# Embedding backend: "hashing" (zero-dependency, local) or "sentence-transformers"
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Answer generation: "extractive" (grounded source text, no model) or "ollama"
LLM_BACKEND=extractive
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
RAG_TOP_K=4

# --- Official-source ingestion (current affairs) ---
# Comma-separated "Name|url" RSS feeds (official/open). Failing feeds are skipped.
SOURCE_FEEDS=PIB|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3,PRS|https://prsindia.org/rss.xml,RBI|https://www.rbi.org.in/notifications_rss.xml
SOURCE_FETCH_TIMEOUT=20
SOURCE_MAX_ITEMS_PER_FEED=40

# --- Scheduled auto-ingestion (the worker container) ---
INGEST_INTERVAL_MINUTES=360
INGEST_ON_STARTUP=true
